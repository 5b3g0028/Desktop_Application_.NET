<Window x:Class="_2026_WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_WpfApp1"
        mc:Ignorable="d"
        Title="Awindow" Height="450" Width="800">
    <Grid Background="#FFFF9D9D">
        <TextBlock x:Name="Title" Height="60" Margin="19,6,0,0" TextWrapping="Wrap"
                   Text="乘法表演示" VerticalAlignment="Top" FontSize="48"
                   Background="#FFFF9900" HorizontalAlignment="Left" Width="245"/>
        <TextBox x:Name="InputTextBox" Margin="191,136,408,0" TextWrapping="Wrap"
                 TextChanged="TextBox_TextChanged" Height="42" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="ResultTextBox" TextWrapping="Wrap" AcceptsReturn="True"
                 IsReadOnly="True" Margin="25,201,25,64" Background="#FFFFEFDE"/>
        <Button x:Name="RunBotton" Content="執行" Margin="0,140,164,0"
                FontSize="18" Click="RunBotton_Click" Height="45" VerticalAlignment="Top" HorizontalAlignment="Right" Width="112"/>
        <TextBox x:Name="NameTextBox" Margin="305,26,294,0" TextWrapping="Wrap" Height="42" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="PhoneTextBox" Margin="303,78,296,0" TextWrapping="Wrap" Height="42" VerticalAlignment="Top" FontSize="16"/>
        <Button x:Name="NameCheck" Content="確認" Margin="0,48,152,0"
                FontSize="18" Click="ConfirmButton_Click" Height="45"
                VerticalAlignment="Top" HorizontalAlignment="Right" Width="112"/>
    </Grid>
</Window>
