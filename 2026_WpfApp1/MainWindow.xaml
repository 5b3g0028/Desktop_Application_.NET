<Window x:Class="_2026_WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_WpfApp1"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Paint App" Height="720" Width="1200">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Height="30">
            <MenuItem Header="檔案" Height="30" VerticalAlignment="Center" FontSize="16">
                <MenuItem Header="開啟新畫布" />
                <MenuItem Header="儲存畫布" />
            </MenuItem>
        </Menu>

        <ToolBarTray Height="40" Background="LightCyan" DockPanel.Dock="Top">
            <ToolBar Height="38" Width="600" Background="#FF96F3F3">
                <Label Content="筆刷色彩" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
                <xctk:ColorPicker x:Name="StrokeColorPicker" Width="100" Height="30"
                                  DisplayColorAndName="True"
                                  SelectedColorChanged="StrokeColorPicker_SelectedColorChanged"/>

                <Label Content="填滿色彩" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
                <xctk:ColorPicker x:Name="FillColorPicker" Width="100" Height="30"
                                  DisplayColorAndName="True"
                                  SelectedColorChanged="FillColorPicker_SelectedColorChanged"/>

                <Slider x:Name="ThicknessSlider" Width="120" Minimum="1" Maximum="10"
                        IsSnapToTickEnabled="True" ValueChanged="ThicknessSlider_ValueChanged"/>
                <Label Content="{Binding Value, ElementName=ThicknessSlider}" FontSize="14" FontWeight="Bold" Foreground="Red" Margin="10,0,0,0"/>
            </ToolBar>

            <ToolBar Height="38" Width="600" Background="#FFA8D684">
                <RadioButton Height="35" Width="35" Tag="Line" ToolTip="直線" Checked="ShapeButton_Checked">
                    <TextBlock Text="━" FontSize="24" Foreground="DarkGreen"/>
                </RadioButton>
                <RadioButton Height="35" Width="35" Tag="Rectangle" ToolTip="矩形" Checked="ShapeButton_Checked">
                    <TextBlock Text="▭" FontSize="20" Foreground="DarkGreen"/>
                </RadioButton>
                <RadioButton Height="35" Width="35" Tag="Ellipse" ToolTip="圓形" Checked="ShapeButton_Checked">
                    <TextBlock Text="●" FontSize="20" Foreground="DarkGreen"/>
                </RadioButton>
                <RadioButton Height="35" Width="35" Tag="Polyline" ToolTip="多邊形" Checked="ShapeButton_Checked">
                    <TextBlock Text="✎" FontSize="20" Foreground="DarkGreen"/>
                </RadioButton>

                <Button Content="橡皮擦" Width="70" Click="EraserButton_Click" Background="#FFD9D9D9" Margin="10,0,0,0"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar Height="35" Background="LightGray" DockPanel.Dock="Bottom">
            <StatusBarItem Width="200">
                <Label x:Name="StatusLabel" Content="Ready" FontSize="14"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem Width="200">
                <Label x:Name="ShapeLabel" Content="形狀" FontSize="14"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <Label x:Name="ColorLabel" Content="色彩" FontSize="14"/>
            </StatusBarItem>
        </StatusBar>

        <Canvas x:Name="MyCanvas"
                Background="#FFF5F5E7"
                MouseLeftButtonDown="MyCanvas_MouseLeftButtonDown"
                MouseMove="MyCanvas_MouseMove"
                MouseLeftButtonUp="MyCanvas_MouseLeftButtonUp"
                MouseEnter="MYcanvas_MouseEnter"/>
    </DockPanel>
</Window>